---
// The 3D island: a dialog opened by any [data-open-viewer] button. three.js is imported on open.
const plyUrl = `${import.meta.env.BASE_URL}assets/cloud_web.ply`;
---
<dialog id="viewer" class="viewer-dialog" aria-labelledby="viewer-title" data-ply={plyUrl}>
  <div class="relative flex h-full w-full flex-col bg-[#0b0b0a] text-[#f5f5f3]">
    <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3">
      <div class="min-w-0">
        <h2 id="viewer-title" class="text-sm font-semibold">Point cloud · interactive view</h2>
        <p class="truncate text-xs text-[#c3c2b7]">Drag to orbit · scroll or pinch to zoom · right-drag or two fingers to pan</p>
      </div>
      <button type="button" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-white/15 hover:bg-white/10" data-close-viewer aria-label="Close the 3D view">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="relative min-h-0 flex-1">
      <div class="absolute inset-0" data-canvas-host></div>
      <div class="absolute inset-0 flex items-center justify-center" data-state="loading">
        <div class="flex flex-col items-center gap-3 text-sm text-[#c3c2b7]" role="status">
          <span class="spinner" aria-hidden="true"></span>
          <span data-progress>Loading the point cloud (0.6 MB)…</span>
        </div>
      </div>
      <div class="absolute inset-0 hidden items-center justify-center p-6" data-state="error">
        <div class="max-w-sm text-center text-sm" role="alert">
          <p class="font-semibold">The 3D view could not be loaded.</p>
          <p class="mt-1 text-[#c3c2b7]" data-error-detail>Your browser may not support WebGL, or the file failed to download.</p>
          <button type="button" class="btn btn-ghost mt-4 !border-white/20 !text-[#f5f5f3]" data-retry>Try again</button>
        </div>
      </div>
      <p class="pointer-events-none absolute bottom-3 left-1/2 w-max max-w-[calc(100%-2rem)] -translate-x-1/2 rounded-full bg-black/60 px-3 py-1.5 text-center font-mono text-[11px] text-[#e7e6df] backdrop-blur">
        40,000 of 100,000 points · decimated for the web · scale not determined
      </p>
    </div>
  </div>
</dialog>

<style>
  .viewer-dialog {
    width: min(100vw - 2rem, 72rem);
    height: min(100dvh - 2rem, 48rem);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background: #0b0b0a;
  }
  @media (max-width: 640px) {
    .viewer-dialog {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
      border: 0;
    }
  }
  .viewer-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(4px);
  }
  .spinner {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 2px solid rgb(255 255 255 / 0.15);
    border-top-color: #5a9ff0;
    animation: spin 0.9s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 3s;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import type { ViewerHandle } from '../scripts/point-cloud-viewer';

  const dialog = document.getElementById('viewer') as HTMLDialogElement | null;
  if (dialog) {
    const host = dialog.querySelector<HTMLElement>('[data-canvas-host]')!;
    const loading = dialog.querySelector<HTMLElement>('[data-state="loading"]')!;
    const error = dialog.querySelector<HTMLElement>('[data-state="error"]')!;
    const progress = dialog.querySelector<HTMLElement>('[data-progress]')!;
    const detail = dialog.querySelector<HTMLElement>('[data-error-detail]')!;
    let handle: ViewerHandle | null = null;
    let session = 0;

    const show = (state: 'loading' | 'error' | 'ready') => {
      loading.style.display = state === 'loading' ? 'flex' : 'none';
      error.style.display = state === 'error' ? 'flex' : 'none';
    };

    const start = async () => {
      const mine = ++session;
      show('loading');
      progress.textContent = 'Loading the point cloud (0.6 MB)…';
      try {
        const { mountViewer } = await import('../scripts/point-cloud-viewer');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const h = await mountViewer({
          container: host,
          url: dialog.dataset.ply!,
          reducedMotion,
          onProgress: (f) => {
            if (f !== null) progress.textContent = `Loading the point cloud… ${Math.round(f * 100)}%`;
          },
        });
        if (mine !== session || !dialog.open) {
          h.dispose();
          return;
        }
        handle = h;
        show('ready');
      } catch (err) {
        if (mine !== session) return;
        console.error('[viewer]', err);
        detail.textContent = !document.createElement('canvas').getContext('webgl2')
          ? 'Your browser does not support WebGL 2, which the 3D view needs.'
          : 'The point cloud failed to download or could not be displayed.';
        show('error');
      }
    };

    const stop = () => {
      session++;
      handle?.dispose();
      handle = null;
    };

    for (const btn of document.querySelectorAll('[data-open-viewer]')) {
      btn.addEventListener('click', () => {
        if (dialog.open) return;
        dialog.showModal();
        start();
      });
    }
    dialog.querySelector('[data-close-viewer]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-retry]')!.addEventListener('click', () => {
      stop();
      start();
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // click on the backdrop
    });
    dialog.addEventListener('close', stop);
  }
</script>
