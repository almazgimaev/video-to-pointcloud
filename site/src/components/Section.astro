---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}
const { id, eyebrow, title, lead } = Astro.props;
---
<section id={id} class="container-page scroll-mt-20 pt-20 sm:pt-28" aria-labelledby={`${id}-title`}>
  <div class="mb-8 max-w-3xl space-y-3 sm:mb-10">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-tight text-fg text-balance sm:text-3xl">{title}</h2>
    {lead && <p class="text-base leading-relaxed text-muted text-pretty sm:text-lg">{lead}</p>}
  </div>
  <slot />
</section>
