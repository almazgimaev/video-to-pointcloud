---
// Light/dark toggle. The initial theme is applied by an inline script in <head> (no flash).
---
<button
  type="button"
  class="theme-toggle inline-flex size-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:bg-surface hover:text-fg"
  aria-label="Switch to light theme"
  data-theme-toggle
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
</style>

<script>
  function label(btn: Element) {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    btn.setAttribute('aria-label', `Switch to ${next} theme`);
  }
  for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
    label(btn);
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* storage unavailable: the choice lasts for this page view only */
      }
      label(btn);
    });
  }
</script>
